# Application Settings
APPLICATION_NAME=ByteBazaar
STATUS=development
PORT=5669
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://127.0.0.1
SERVER_HOST=localhost

# MongoDB Database Connections

MDB_URL=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/ByteBazaar?retryWrites=true&w=majority

# Session Storage Connection (connect-mongo)
SESSION_DB_URL=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/Sessions?retryWrites=true&w=majority
SESSION_COLL=Sessions
SESSION_SECRET_KEY=your_session_secret_key_here

# Authentication & Security
JWT_SECRET_KEY=your_jwt_secret_key_here
AUTH_TOKEN_EXPIRY_TIME=24H
AUTH_TOKEN_KEY_TITLE=auth_token
HASH_ENCRYPT_ROUNDS=10

# Default Administrator (Created automatically on startup if not present)
ADMIN_FULLNAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL= 
ADMIN_PASSWORD=your_admin_password_here

# File Upload Paths
UPLOAD_PATH=uploads/
PUBLIC_PATH=public/
CONTENT_PATH=uploads/
USER_CONTENT_DIR=uploads/users
CONTENT_IMAGES_PATH=uploads/images
PRODUCT_FEATURE_IMAGE_FIELD=featureImage
PRODUCT_GALLERY_IMAGE_FIELD=gallery
USER_PROFILE_IMAGE_KEY=profileImage


# Stripe Payment Gateway
STRIPE_TEST_KEY=sk_test_your_stripe_secret_key
PAYMENT_LISTEN_API=/listen-payment-hook
PAYMENT_CANCEL_API=/cancel-payment
PAYMENT_STATUS_PAGE=/payment-status

# Email / SMTP Configuration (Nodemailer - e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MAILSENDER_MAIL=your_email@gmail.com


